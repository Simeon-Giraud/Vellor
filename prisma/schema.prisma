// This is your Prisma schema file (Prisma v5)
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  supabaseId           String            @unique
  fullName             String?
  avatarUrl            String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt
  stripeCustomerId     String?           @unique
  stripeSubscriptionId String?           @unique
  stripePriceId        String?
  subscriptionStatus   String?           @default("demo")
  trialEndsAt          DateTime?
  hasSeenWelcome       Boolean           @default(false)
  projects             Project[]
  preferences          UserPreferences?

  @@index([supabaseId])
  @@index([stripeCustomerId])
  @@map("users")
}

model UserPreferences {
  id               String   @id @default(cuid())
  userId           String   @unique
  emailAlerts      Boolean  @default(true)
  weeklySummary    Boolean  @default(true)
  mentionDropAlert Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  domain      String
  brandName   String?
  industry    String?
  status      String   @default("generating")
  competitors String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  lastRunAt   DateTime?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prompts     Prompt[]
  runs        ProjectRun[]

  @@index([userId])
  @@map("projects")
}


model Prompt {
  id        String          @id @default(cuid())
  projectId String
  text      String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  results   PromptResult[]

  @@index([projectId])
  @@map("prompts")
}

enum AIEngine {
  CHATGPT
  GEMINI
  PERPLEXITY
}

model PromptResult {
  id              String   @id @default(cuid())
  promptId        String
  engine          AIEngine
  response        String   @db.Text
  brandMentioned  Boolean  @default(false)
  mentionPosition Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  prompt          Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  analyses        CompetitorAnalysis[]

  @@index([promptId])
  @@index([createdAt])
  @@map("prompt_results")
}

model CompetitorAnalysis {
  id               String       @id @default(cuid())
  promptResultId   String
  competitorDomain String
  reasoning        String       @db.Text
  actionableAdvice String       @db.Text
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @default(now()) @updatedAt

  promptResult     PromptResult @relation(fields: [promptResultId], references: [id], onDelete: Cascade)

  @@index([promptResultId])
  @@map("competitor_analyses")
}

model ProjectRun {
  id        String   @id @default(cuid())
  projectId String
  runType   String   // "scheduled" or "on_demand"
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt])
  @@map("project_runs")
}

